{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2021",
    "lib": ["ES2021"],
    "rootDir": "src",
    "outDir": "dist/server",
    "noEmit": false,
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["src/server/**/*"]
}
